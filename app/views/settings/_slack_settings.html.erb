<p>
	<label for="settings_delivery_enabled">Enable Slack delivery</label>
	<%= hidden_field_tag 'settings[delivery_enabled]', '0' %>
	<%= check_box_tag 'settings[delivery_enabled]', '1', settings['delivery_enabled'] == '1', id: 'settings_delivery_enabled' %>
</p>

<p>
	<label for="settings_bot_token">Slack bot token</label>
	<%= password_field_tag 'settings[bot_token]', '', autocomplete: 'new-password', aria: {describedby: 'slack-bot-token-status'} %>
	<span id="slack-bot-token-status"><%= settings['bot_token'].present? ? 'Configured' : 'Not configured' %></span>
</p>

<p>
	<label for="settings_channel">Slack Channel</label>
	<input type="text" id="settings_channel" value="<%= settings['channel'] %>" name="settings[channel]" />
</p>

<p>
	Use a private conversation ID (C… or G…) and invite the bot. Create
	<a href="/custom_fields/new?type=ProjectCustomField">project custom fields</a>
	named "Slack Channel" and "Slack Support Channel" for per-project routes.
	Blank values inherit; a nonblank invalid value or - disables that route.
</p>

<p>
	<label for="settings_username">Slack Icon</label>
	<input type="text" id="settings_icon" value="<%= settings['icon'] %>" name="settings[icon]" />
</p>

<p>
	<label for="settings_username">Slack Username</label>
	<input type="text" id="settings_username" value="<%= settings['username'] %>" name="settings[username]" />
</p>

<p>
	<label for="settings_display_watchers">Display Watchers?</label>
	<select id="settings_display_watchers" value="<%= settings['display_watchers'] %>" name="settings[display_watchers]">
		<option value="yes">Yes</option>
		<option value="no" <%= settings['display_watchers'] != 'yes' ? %q(selected="selected") : '' %>>No</option>
	</select>
</p>

<p>
	<label for="settings_post_updates">Post Issue Updates?</label>
	<input type="checkbox" id="settings_post_updates" value="1" name="settings[post_updates]" <%= settings['post_updates'] == '1' ? 'checked="checked"' : '' %> />
</p>
