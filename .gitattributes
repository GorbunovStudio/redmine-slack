# Set the default behavior, in case people don't have core.autocrlf set.
* text=input

# Denote all files that are truly binary and should not be modified.
*.ai binary
*.db binary
*.eot binary
*.eps binary
*.jpg binary
*.gif binary
*.otf binary
*.pdf binary
*.phar binary
*.png binary
*.swf binary
*.ttf binary
*.TTF binary
*.woff binary
*.woff2 binary
*.mp4 binary
